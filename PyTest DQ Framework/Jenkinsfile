pipeline {
	agent any

	environment {
		DB_HOST = 'postgres'
		DB_PORT = '5432'
		DB_NAME = 'mydatabase'
	}

	stages {
        stage('Install Python') {
            steps {
                sh '''
                    if ! command -v python3 >/dev/null 2>&1 || ! python3 -m venv --help >/dev/null 2>&1; then
                        apt-get update
                        apt-get install -y python3 python3-pip python3-venv
                    fi
                    python3 --version
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Parquet DQ tests') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'POSTGRES_SECRET',
                    usernameVariable: 'POSTGRES_USER',
                    passwordVariable: 'POSTGRES_PASSWORD'
                )]) {
                    dir('PyTest DQ Framework') {
                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            sh 'mkdir -p html_report'
                            sh '''
                                . venv/bin/activate
                                pytest tests -m "parquet_data" \\
                                    --db_host="$DB_HOST" \\
                                    --db_port="$DB_PORT" \\
                                    --db_name="$DB_NAME" \\
                                    --db_user="$POSTGRES_USER" \\
                                    --db_password="$POSTGRES_PASSWORD" \\
                                    --html=html_report/index.html --self-contained-html
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**', allowEmptyArchive: true
            publishHTML(target: [
                allowMissing: false,
                keepAll: true,
                reportDir: 'PyTest DQ Framework/html_report',
                reportFiles: 'index.html',
                reportName: 'Parquet DQ Test Report'
            ])
        }
    }
}
